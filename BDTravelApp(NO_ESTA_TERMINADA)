    print("Compra de eSIM registrada correctamente.")


# 8. CONSULTAR COMPRAS DE ESIM

def consultar_compras():
    email = input("Introduce tu email: ")

    cursor.execute("""
        SELECT ESIM.pais,
               ESIM.datos_gb,
               ESIM.dias,
               ESIM.precio,
               COMPRA_ESIM.fecha
        FROM COMPRA_ESIM
        JOIN USUARIO ON COMPRA_ESIM.usuario_id = USUARIO.id
        JOIN ESIM ON COMPRA_ESIM.esim_id = ESIM.id
        WHERE USUARIO.email = ?
    """, (email,))

    compras = cursor.fetchall()

    if len(compras) == 0:
        print("No tienes compras de eSIM.")
    else:
        print("\n--- TUS COMPRAS DE ESIM ---")

