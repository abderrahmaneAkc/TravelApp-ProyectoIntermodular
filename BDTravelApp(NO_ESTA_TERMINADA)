        )


# 3. REGISTRAR USUARIO

def registrar_usuario():
    nombre = input("Nombre: ")
    email = input("Email: ")
    pais = input("Pais: ")

    try:
        cursor.execute("""
            INSERT INTO USUARIO (nombre, email, pais)
            VALUES (?, ?, ?)
        """, (nombre, email, pais))

        conexion.commit()
        print("Usuario registrado correctamente.")

    except sqlite3.IntegrityError:
        print("Error: ese email ya esta registrado.")


# 4. HACER UNA RESERVA

def hacer_reserva():
    consultar_servicios()

    email = input("\nIntroduce tu email: ")

    cursor.execute(
        "SELECT id FROM USUARIO WHERE email = ?",
        (email,)
    )
    usuario = cursor.fetchone()

    if usuario is None:
        print("Usuario no encontrado. Registrate primero.")
        return

    id_servicio = int(input("ID del servicio que quieres reservar: "))
    fecha = input("Fecha de la reserva (AAAA-MM-DD): ")

    cursor.execute(
        "SELECT id FROM SERVICIO_TURISTICO WHERE id = ?",
        (id_servicio,)
    )

    if cursor.fetchone() is None:
        print("El servicio no existe.")
        return

    cursor.execute("""
        INSERT INTO RESERVA
        (usuario_id, servicio_id, fecha, estado)
        VALUES (?, ?, ?, ?)
    """, (usuario[0], id_servicio, fecha, "Pendiente"))

    conexion.commit()
    print("Reserva realizada correctamente.")


# 5. DEJAR UNA RESENA

def dejar_resena():
    consultar_servicios()

    email = input("\nIntroduce tu email: ")

    cursor.execute(
        "SELECT id FROM USUARIO WHERE email = ?",
        (email,)
    )
    usuario = cursor.fetchone()

    if usuario is None:
        print("Usuario no encontrado.")
        return

    id_servicio = int(input("ID del servicio: "))
    puntuacion = int(input("Puntuacion del 1 al 5: "))

    if puntuacion < 1 or puntuacion > 5:
        print("La puntuacion debe estar entre 1 y 5.")
        return

    comentario = input("Escribe tu comentario: ")

    cursor.execute("""
        SELECT id FROM SERVICIO_TURISTICO WHERE id = ?
    """, (id_servicio,))

    if cursor.fetchone() is None:
        print("El servicio no existe.")
        return

    cursor.execute("""
        INSERT INTO RESENA
        (usuario_id, servicio_id, puntuacion, comentario)
        VALUES (?, ?, ?, ?)
    """, (usuario[0], id_servicio, puntuacion, comentario))

    conexion.commit()
    print("Resena guardada correctamente.")


# 6. CONSULTAR RESERVAS

def consultar_reservas():
    email = input("Introduce tu email: ")

    cursor.execute("""
        SELECT RESERVA.id,
               SERVICIO_TURISTICO.nombre,
               RESERVA.fecha,
               RESERVA.estado
        FROM RESERVA
        JOIN USUARIO ON RESERVA.usuario_id = USUARIO.id
        JOIN SERVICIO_TURISTICO
        ON RESERVA.servicio_id = SERVICIO_TURISTICO.id
        WHERE USUARIO.email = ?
    """, (email,))

    reservas = cursor.fetchall()

    if len(reservas) == 0:
        print("No tienes reservas.")
    else:
        print("\n--- TUS RESERVAS ---")

        for reserva in reservas:
            print(
                "ID:", reserva[0],
                "| Servicio:", reserva[1],
                "| Fecha:", reserva[2],
                "| Estado:", reserva[3]
            )


# 7. COMPRAR ESIM

