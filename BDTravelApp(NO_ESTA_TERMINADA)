# 1. CONSULTAR CIUDADES Y SERVICIOS

def consultar_servicios():
    cursor.execute("""
        SELECT SERVICIO_TURISTICO.id,
               SERVICIO_TURISTICO.nombre,
               SERVICIO_TURISTICO.tipo,
               SERVICIO_TURISTICO.precio,
               CIUDAD.nombre,
               CIUDAD.pais
        FROM SERVICIO_TURISTICO
        JOIN CIUDAD
        ON SERVICIO_TURISTICO.ciudad_id = CIUDAD.id
    """)

    servicios = cursor.fetchall()

    print("\n--- SERVICIOS TURISTICOS ---")

    for servicio in servicios:
        print(
            "ID:", servicio[0],
            "|", servicio[1],
            "|", servicio[2],
            "|", servicio[3], "euros",
            "|", servicio[4],
            "-", servicio[5]
        )


